GEEKNOSY_POSTGRES_PASSWORD=replace-with-a-long-random-password
# Vacío para uso local. En entornos compartidos use una o más claves separadas por coma.
GEEKNOSY_API_KEYS=
GEEKNOSY_CORS_ORIGINS=http://localhost:3000
# Scope optional. Empty means any public HTTP(S) target is allowed.
GEEKNOSY_ALLOWED_DOMAINS=example.com
GEEKNOSY_ALLOWED_CIDRS=
GEEKNOSY_ALLOW_PRIVATE_TARGETS=false
GEEKNOSY_WEBHOOK_URL=
GEEKNOSY_WEBHOOK_SECRET=
# Perfil aislado `authorized` (deshabilitado por defecto).
GEEKNOSY_ALLOW_ACTIVE_CHECKS=false
GEEKNOSY_AUTHORIZED_ALLOW_PRIVATE_TARGETS=false
# Ejemplo: {"staging":{"header":"Authorization","value":"Bearer replace-me"}}
GEEKNOSY_AUTH_PROFILES_JSON={}
# Enriquecimiento opcional: envía solo nombre y versión de librerías públicas a api.osv.dev.
GEEKNOSY_OSV_ENABLED=false
